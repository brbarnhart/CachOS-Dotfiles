binds {

    // ────────────── Keybindings ──────────────
    // https://github.com/YaLTeR/niri/wiki/Configuration:-Key-Bindings

    // ─── Noctalia v5 keybinds ───
    // https://docs.noctalia.dev/noctalia/ipc/

    // ─── Applications ───
    Mod+Return                          hotkey-overlay-title="Ghostty"              { spawn "ghostty"; }
    Mod+Space                           hotkey-overlay-title="Open App Launcher"    { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+B                               hotkey-overlay-title="Brave"                { spawn "brave"; }
    Mod+ALT+L                           hotkey-overlay-title="Lock Screen"          { spawn-sh "noctalia msg session lock"; }
    Mod+ALT+Q                           hotkey-overlay-title="Session Menu"         { spawn-sh "noctalia msg panel-toggle session"; }
    Mod+E                               hotkey-overlay-title="File Manager"         { spawn "nautilus"; }

    // ─── Media Controls ───
    XF86AudioRaiseVolume                allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume                allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute                       allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    XF86AudioMicMute                    allow-when-locked=true { spawn-sh "noctalia msg mic-mute"; }
    XF86AudioNext                       allow-when-locked=true { spawn-sh "noctalia msg media next"; }
    XF86AudioPrev                       allow-when-locked=true { spawn-sh "noctalia msg media previous"; }
    XF86AudioPlay                       allow-when-locked=true { spawn-sh "noctalia msg media toggle"; }
    XF86AudioPause                      allow-when-locked=true { spawn-sh "noctalia msg media toggle"; }

    // ─── Brightness Controls ───
    // v4 brightnessStep was 5. The bare command uses Noctalia's default step.
    XF86MonBrightnessUp                 allow-when-locked=true { spawn-sh "noctalia msg brightness-up 5"; }
    XF86MonBrightnessDown               allow-when-locked=true { spawn-sh "noctalia msg brightness-down 5"; }

    // ─── Window Movement and Focus ───
    Mod+Shift+Q                         { close-window; }

    Mod+H                               { focus-column-left; }
    Mod+L                               { focus-column-right; }

    Mod+Shift+H                         { move-column-left; }
    Mod+Shift+L                         { move-column-right; }

    Mod+Shift+BracketLeft               { move-column-to-monitor-left; }
    Mod+Shift+BracketRight              { move-column-to-monitor-right; }

    Mod+Shift+J                         cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Shift+K                         cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+BracketLeft                     { focus-monitor-left; }
    Mod+BracketRight                    { focus-monitor-right; }

    // ─── Workspace Switching ───
    Mod+WheelScrollDown                 cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp                   cooldown-ms=150 { focus-workspace-up; }
    Mod+J                               { focus-workspace-down; }
    Mod+K                               { focus-workspace-up; }

    Mod+1                               { focus-workspace 1; }
    Mod+2                               { focus-workspace 2; }
    Mod+3                               { focus-workspace 3; }
    Mod+4                               { focus-workspace 4; }

    Mod+TAB                             { focus-workspace-previous; }

    // ─── Layout Controls ───
    Mod+F                               { expand-column-to-available-width; }
    Mod+C                               { center-column; }
    Mod+CTRL+C                          { center-visible-columns; }
    Mod+Minus                           { set-column-width "-10%"; }
    Mod+Equal                           { set-column-width "+10%"; }
    Mod+Shift+Minus                     { set-window-height "-10%"; }
    Mod+Shift+Equal                     { set-window-height "+10%"; }

    // ─── Modes ───
    Mod+T                               { toggle-window-floating; }
    Mod+Shift+F                         { fullscreen-window; }
    Mod+W                               { toggle-column-tabbed-display; }

    // ─── Screenshots ───
    Mod+Shift+S                         { screenshot; }
    //CTRL+Shift+2                        { screenshot-screen; }
    //CTRL+Shift+3                        { screenshot-window; }

    // --- Emergency Escape Key ───
    // Use this when a fullscreen app blocks your keybinds.
    // It disables any active keyboard shortcut inhibitor, restoring control.
    Mod+ESCAPE                          allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // ─── Exit / Power ───
    CTRL+ALT+Delete                     { quit; }
    Mod+O                               repeat=false { toggle-overview; }

    // --- Misc ───
    Mod+D                               hotkey-overlay-title="Toggle Light/Dark Theme" {
        spawn-sh "noctalia msg theme-mode-toggle";
    }

    // The v4 keybind-cheatsheet plugin is Quickshell-only. This opens Niri's overlay.
    Mod+F1                              hotkey-overlay-title="Keybind Cheatsheet" {
        show-hotkey-overlay;
    }
}
